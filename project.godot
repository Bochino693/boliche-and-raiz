; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dragon Bowling"
config/version="2.0.2-pro-ultra-android10"
run/main_scene="res://scene/Main Menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
config/quit_on_go_back=false
config/icon="res://sprites/icone_dragon_bowling_exe.png"

[autoload]

Tela="*res://autoload/Tela.gd"
MusicManager="*res://scripts/music_manager.gd"
GameConfig="*res://autoload/GameConfig.gd"
ArduinoBridge="*res://autoload/ArduinoBridge.gd"
ArcadeControls="*res://autoload/ArcadeControls.gd"

[display]

window/size/viewport_width=1536
window/size/viewport_height=1024
window/size/mode=3
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[dragon]

tela/giro=1

[editor_plugins]

enabled=PackedStringArray()

[input]

input_z={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":2,"pressure":0.0,"pressed":true,"script":null)]
}
