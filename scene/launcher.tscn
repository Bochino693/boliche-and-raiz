[gd_scene format=3 uid="uid://lv8oq2wt0dgq"]

[sub_resource type="GDScript" id="GDScript_dww42"]
script/source = "extends Control

@export_file(\"*.tscn\") var caminho_menu: String = \"res://scene/Main Menu.tscn\"
@export var tempo_estabilizacao: float = 12.0
@export var tempo_total_intro: float = 5.8
@export var fechar_launcher_apos_abrir: bool = true

@onready var background: ColorRect = $Background
@onready var back_glow_top: ColorRect = $BackGlowTop
@onready var back_glow_bottom: ColorRect = $BackGlowBottom
@onready var vignette_left: ColorRect = $VignetteLeft
@onready var vignette_right: ColorRect = $VignetteRight

@onready var panel_shadow: ColorRect = $PanelShadow
@onready var main_panel: ColorRect = $MainPanel
@onready var accent_line_top: ColorRect = $AccentLineTop
@onready var accent_line_bottom: ColorRect = $AccentLineBottom

@onready var logo: TextureRect = $Logo
@onready var titulo: Label = $Titulo
@onready var subtitulo: Label = $Subtitulo
@onready var status_label: Label = $Status
@onready var progress_frame: ColorRect = $ProgressFrame
@onready var progress_bg: ColorRect = $ProgressBg
@onready var progress_fill: ColorRect = $ProgressFill
@onready var loading_hint: Label = $LoadingHint

@onready var fade_rect: ColorRect = $Fade
@onready var timer: Timer = $Timer

var tempo_inicio: float = 0.0
var abrindo_jogo: bool = false
var progresso_visual: float = 0.0


func _ready() -> void:
	Input.set_mouse_mode(Input.MOUSE_MODE_HIDDEN)

	set_anchors_preset(Control.PRESET_FULL_RECT)
	offset_left = 0
	offset_top = 0
	offset_right = 0
	offset_bottom = 0

	_configurar_visual()
	_ajustar_layout()

	var viewport := get_viewport()
	if viewport != null and not viewport.size_changed.is_connected(_on_viewport_size_changed):
		viewport.size_changed.connect(_on_viewport_size_changed)

	tempo_inicio = Time.get_ticks_msec() * 0.001
	_animar_entrada()

	timer.wait_time = max(tempo_total_intro, tempo_estabilizacao)
	timer.one_shot = true
	if not timer.timeout.is_connected(_abrir_jogo):
		timer.timeout.connect(_abrir_jogo)
	timer.start()


func _process(_delta: float) -> void:
	if abrindo_jogo:
		return

	var agora: float = Time.get_ticks_msec() * 0.001
	var decorrido: float = agora - tempo_inicio
	var duracao_alvo: float = max(tempo_total_intro, tempo_estabilizacao)

	var alvo_progresso: float = clamp(decorrido / duracao_alvo, 0.0, 1.0)
	progresso_visual = lerp(progresso_visual, alvo_progresso, 0.07)

	_atualizar_barra(progresso_visual)
	_atualizar_status(progresso_visual)
	_animar_vivo(decorrido)


func _exit_tree() -> void:
	if Input.get_mouse_mode() == Input.MOUSE_MODE_HIDDEN:
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)


func _on_viewport_size_changed() -> void:
	call_deferred(\"_ajustar_layout\")


func _configurar_visual() -> void:
	background.color = Color(0.025, 0.035, 0.055, 1.0)

	back_glow_top.color = Color(0.10, 0.22, 0.34, 0.46)
	back_glow_bottom.color = Color(1.0, 0.52, 0.12, 0.12)

	vignette_left.color = Color(0.0, 0.0, 0.0, 0.18)
	vignette_right.color = Color(0.0, 0.0, 0.0, 0.18)

	panel_shadow.color = Color(0.0, 0.0, 0.0, 0.30)
	main_panel.color = Color(0.05, 0.08, 0.12, 0.82)

	accent_line_top.color = Color(1.0, 0.68, 0.20, 0.95)
	accent_line_bottom.color = Color(0.42, 0.82, 1.0, 0.58)

	logo.texture = load(\"res://sprites/logoofi.png\")
	logo.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	logo.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	logo.modulate = Color(1, 1, 1, 0)

	titulo.text = \"LAZER & SPORT\"
	titulo.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	titulo.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	titulo.add_theme_font_size_override(\"font_size\", 30)
	titulo.add_theme_color_override(\"font_color\", Color(1.0, 1.0, 1.0, 1.0))
	titulo.add_theme_color_override(\"font_outline_color\", Color(0.0, 0.0, 0.0, 1.0))
	titulo.add_theme_constant_override(\"outline_size\", 5)
	titulo.modulate.a = 0.0

	subtitulo.text = \"ARCADE SYSTEM BOOT\"
	subtitulo.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	subtitulo.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	subtitulo.add_theme_font_size_override(\"font_size\", 18)
	subtitulo.add_theme_color_override(\"font_color\", Color(1.0, 0.72, 0.22, 1.0))
	subtitulo.add_theme_color_override(\"font_outline_color\", Color(0.0, 0.0, 0.0, 1.0))
	subtitulo.add_theme_constant_override(\"outline_size\", 4)
	subtitulo.modulate.a = 0.0

	status_label.text = \"Inicializando sistema...\"
	status_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	status_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	status_label.add_theme_font_size_override(\"font_size\", 22)
	status_label.add_theme_color_override(\"font_color\", Color(0.86, 0.93, 1.0, 1.0))
	status_label.add_theme_color_override(\"font_outline_color\", Color(0.0, 0.0, 0.0, 1.0))
	status_label.add_theme_constant_override(\"outline_size\", 4)
	status_label.modulate.a = 0.0

	loading_hint.text = \"POWERING ARCADE ENVIRONMENT\"
	loading_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	loading_hint.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	loading_hint.add_theme_font_size_override(\"font_size\", 14)
	loading_hint.add_theme_color_override(\"font_color\", Color(0.68, 0.78, 0.90, 0.92))
	loading_hint.add_theme_color_override(\"font_outline_color\", Color(0.0, 0.0, 0.0, 1.0))
	loading_hint.add_theme_constant_override(\"outline_size\", 2)
	loading_hint.modulate.a = 0.0

	progress_frame.color = Color(1.0, 1.0, 1.0, 0.10)
	progress_bg.color = Color(0.08, 0.12, 0.17, 0.96)
	progress_fill.color = Color(1.0, 0.62, 0.14, 1.0)

	fade_rect.color = Color(0, 0, 0, 1)
	fade_rect.modulate.a = 1.0


func _ajustar_layout() -> void:
	var tela: Vector2 = get_viewport_rect().size
	size = tela

	background.position = Vector2.ZERO
	background.size = tela

	back_glow_top.position = Vector2(-tela.x * 0.10, -tela.y * 0.06)
	back_glow_top.size = Vector2(tela.x * 1.20, tela.y * 0.34)

	back_glow_bottom.position = Vector2(-tela.x * 0.02, tela.y * 0.76)
	back_glow_bottom.size = Vector2(tela.x * 1.04, tela.y * 0.22)

	vignette_left.position = Vector2.ZERO
	vignette_left.size = Vector2(tela.x * 0.12, tela.y)

	vignette_right.position = Vector2(tela.x * 0.88, 0)
	vignette_right.size = Vector2(tela.x * 0.12, tela.y)

	var painel_w: float = min(tela.x * 0.70, 560.0)
	var painel_h: float = min(tela.y * 0.58, 760.0)
	var painel_x: float = (tela.x - painel_w) * 0.5
	var painel_y: float = tela.y * 0.14

	panel_shadow.position = Vector2(painel_x, painel_y + 18.0)
	panel_shadow.size = Vector2(painel_w, painel_h)

	main_panel.position = Vector2(painel_x, painel_y)
	main_panel.size = Vector2(painel_w, painel_h)

	accent_line_top.position = Vector2(painel_x + 20.0, painel_y + 18.0)
	accent_line_top.size = Vector2(painel_w - 40.0, 4.0)

	accent_line_bottom.position = Vector2(painel_x + 36.0, painel_y + painel_h - 18.0)
	accent_line_bottom.size = Vector2(painel_w - 72.0, 2.0)

	var logo_w: float = min(painel_w * 0.52, 280.0)
	var logo_h: float = logo_w
	logo.size = Vector2(logo_w, logo_h)
	logo.position = Vector2((tela.x - logo_w) * 0.5, painel_y + 46.0)

	titulo.position = Vector2(painel_x + 20.0, painel_y + painel_h * 0.50)
	titulo.size = Vector2(painel_w - 40.0, 40.0)

	subtitulo.position = Vector2(painel_x + 20.0, painel_y + painel_h * 0.57)
	subtitulo.size = Vector2(painel_w - 40.0, 28.0)

	status_label.position = Vector2(painel_x + 20.0, painel_y + painel_h * 0.70)
	status_label.size = Vector2(painel_w - 40.0, 32.0)

	var barra_largura: float = painel_w * 0.72
	progress_frame.position = Vector2((tela.x - barra_largura) * 0.5 - 6.0, painel_y + painel_h * 0.80 - 6.0)
	progress_frame.size = Vector2(barra_largura + 12.0, 28.0)

	progress_bg.position = Vector2((tela.x - barra_largura) * 0.5, painel_y + painel_h * 0.80)
	progress_bg.size = Vector2(barra_largura, 16.0)

	progress_fill.position = progress_bg.position
	progress_fill.size = Vector2(0, progress_bg.size.y)

	loading_hint.position = Vector2(painel_x + 20.0, painel_y + painel_h * 0.87)
	loading_hint.size = Vector2(painel_w - 40.0, 24.0)

	fade_rect.position = Vector2.ZERO
	fade_rect.size = tela


func _animar_entrada() -> void:
	logo.scale = Vector2(0.76, 0.76)
	logo.position.y += 70.0
	main_panel.modulate.a = 0.0
	panel_shadow.modulate.a = 0.0

	titulo.position.y += 36.0
	subtitulo.position.y += 28.0
	status_label.position.y += 24.0
	loading_hint.position.y += 16.0

	progress_frame.modulate.a = 0.0
	progress_bg.modulate.a = 0.0
	progress_fill.modulate.a = 0.0

	var tw := create_tween()
	tw.set_parallel(true)

	tw.tween_property(fade_rect, \"modulate:a\", 0.0, 0.45).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)

	tw.tween_property(panel_shadow, \"modulate:a\", 1.0, 0.30).set_delay(0.08)
	tw.tween_property(main_panel, \"modulate:a\", 1.0, 0.32).set_delay(0.08)

	tw.tween_property(logo, \"modulate:a\", 1.0, 0.42).set_delay(0.18)
	tw.tween_property(logo, \"scale\", Vector2.ONE, 0.50).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT).set_delay(0.18)
	tw.tween_property(logo, \"position:y\", logo.position.y - 70.0, 0.50).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT).set_delay(0.18)

	tw.tween_property(titulo, \"modulate:a\", 1.0, 0.30).set_delay(0.34)
	tw.tween_property(titulo, \"position:y\", titulo.position.y - 36.0, 0.38).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT).set_delay(0.34)

	tw.tween_property(subtitulo, \"modulate:a\", 1.0, 0.30).set_delay(0.44)
	tw.tween_property(subtitulo, \"position:y\", subtitulo.position.y - 28.0, 0.38).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT).set_delay(0.44)

	tw.tween_property(status_label, \"modulate:a\", 1.0, 0.26).set_delay(0.56)
	tw.tween_property(status_label, \"position:y\", status_label.position.y - 24.0, 0.34).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT).set_delay(0.56)

	tw.tween_property(progress_frame, \"modulate:a\", 1.0, 0.20).set_delay(0.66)
	tw.tween_property(progress_bg, \"modulate:a\", 1.0, 0.20).set_delay(0.66)
	tw.tween_property(progress_fill, \"modulate:a\", 1.0, 0.20).set_delay(0.66)

	tw.tween_property(loading_hint, \"modulate:a\", 1.0, 0.24).set_delay(0.74)
	tw.tween_property(loading_hint, \"position:y\", loading_hint.position.y - 16.0, 0.30).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT).set_delay(0.74)


func _animar_vivo(decorrido: float) -> void:
	var pulso_logo: float = 1.0 + sin(decorrido * 2.0) * 0.012
	logo.scale = Vector2.ONE * pulso_logo

	var brilho_topo: float = 0.82 + abs(sin(decorrido * 1.2)) * 0.18
	back_glow_top.modulate.a = brilho_topo

	var brilho_bottom: float = 0.55 + abs(sin(decorrido * 1.8)) * 0.18
	back_glow_bottom.modulate.a = brilho_bottom

	var brilho_barra: float = 0.92 + abs(sin(decorrido * 5.0)) * 0.08
	progress_fill.modulate = Color(brilho_barra, brilho_barra * 0.72, 0.14, 1.0)

	var painel_respira: float = 0.97 + abs(sin(decorrido * 1.6)) * 0.03
	main_panel.scale = Vector2.ONE * painel_respira
	main_panel.pivot_offset = main_panel.size * 0.5


func _atualizar_barra(valor: float) -> void:
	valor = clamp(valor, 0.0, 1.0)
	progress_fill.size.x = progress_bg.size.x * valor


func _atualizar_status(valor: float) -> void:
	if valor < 0.18:
		status_label.text = \"Inicializando sistema...\"
	elif valor < 0.42:
		status_label.text = \"Carregando áudio e serviços...\"
	elif valor < 0.68:
		status_label.text = \"Preparando ambiente do jogo...\"
	elif valor < 0.95:
		status_label.text = \"Finalizando boot arcade...\"
	else:
		status_label.text = \"Abrindo Dragon Bowling...\"

func _abrir_jogo() -> void:
	if abrindo_jogo:
		return

	abrindo_jogo = true
	status_label.text = \"Abrindo Main Menu...\"
	progress_fill.size.x = progress_bg.size.x

	if caminho_menu.is_empty():
		abrindo_jogo = false
		push_error(\"Caminho do menu vazio.\")
		return

	if not ResourceLoader.exists(caminho_menu):
		abrindo_jogo = false
		push_error(\"Cena não encontrada: \" + caminho_menu)
		return

	print(\"1 - caminho encontrado: \", caminho_menu)

	var menu_scene: PackedScene = load(caminho_menu) as PackedScene
	if menu_scene == null:
		abrindo_jogo = false
		push_error(\"Não foi possível carregar PackedScene: \" + caminho_menu)
		return

	print(\"2 - packed scene carregada\")

	var teste_instancia: Node = menu_scene.instantiate()
	if teste_instancia == null:
		abrindo_jogo = false
		push_error(\"Não foi possível instanciar a cena do menu.\")
		return

	print(\"3 - cena instanciada com sucesso: \", teste_instancia.name)
	teste_instancia.queue_free()

	var tw: Tween = create_tween()
	tw.set_parallel(true)
	tw.tween_property(fade_rect, \"modulate:a\", 1.0, 0.22).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
	tw.tween_property(main_panel, \"modulate:a\", 0.0, 0.18)
	tw.tween_property(panel_shadow, \"modulate:a\", 0.0, 0.18)
	await tw.finished

	print(\"4 - tentando trocar para menu\")

	var erro: Error = get_tree().change_scene_to_file(caminho_menu)

	print(\"5 - retorno change_scene_to_file: \", erro)

	if erro != OK:
		abrindo_jogo = false
		fade_rect.modulate.a = 0.0
		main_panel.modulate.a = 1.0
		panel_shadow.modulate.a = 1.0
		push_error(\"Falha ao trocar para o menu: \" + caminho_menu + \" | código: \" + str(erro))
"

